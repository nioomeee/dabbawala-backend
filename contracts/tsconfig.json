{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "./hardhat.config.ts",
    "./scripts/**/*.ts",
    "./test/hardhat/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
