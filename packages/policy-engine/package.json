  },
  "dependencies": {
    "@dabbawala/domain": "workspace:*",
    "@dabbawala/shared": "workspace:*",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "2.1.9"
  }
}