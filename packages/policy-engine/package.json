{
  "name": "@dabbawala/policy-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Local policy engine: validates 0G model proposals against ENS policy before any action or payment.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
