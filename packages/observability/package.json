    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@dabbawala/config": "workspace:*",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "2.1.9"
  }
}