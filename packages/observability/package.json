{
  "name": "@dabbawala/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Structured logging (Pino), health checks, and error utilities.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
