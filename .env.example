# ============================================================
# Dabbawala Protocol — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the REPLACE_WITH_* values.
# NEVER commit .env to git. NEVER hardcode real keys in code.
# Testnets only: Sepolia, 0G Galileo, Hedera testnet.
# Robot names are final per the frontend console (implementation.md §2):
# ramu / sakhu / janu. Local EVM: Hardhat. Database: NeonDB.
# ============================================================

# --- Application ---
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000

# --- Database (NeonDB cloud PostgreSQL) ---
# Pooled connection string from the Neon dashboard (app runtime).
# Migrations use the direct (non-pooled) string. sslmode=require is mandatory.
# docs/implementation.md §5
DATABASE_URL=postgres://dabbawala:REPLACE_WITH_NEON_PASSWORD@REPLACE_WITH_NEON_ENDPOINT/dabbawala_dev?sslmode=require

# --- Local EVM (Hardhat) ---
# npx hardhat node defaults: 127.0.0.1:8545, chain id 31337
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# --- Sepolia (ENSv2) ---
SEPOLIA_RPC_URL=REPLACE_WITH_TESTNET_VALUE
SEPOLIA_CHAIN_ID=11155111

# --- ENSv2 (Sepolia) ---
# Fill after S-ENS spike; ref: R-ENS-2, REFERENCES.md §4
ENS_PARENT_NAME=REPLACE_WITH_TESTNET_VALUE
ENS_VERIFIABLE_FACTORY_ADDRESS=REPLACE_WITH_TESTNET_VALUE
ENS_ROBOT_RAMU_RESOLVER=REPLACE_WITH_TESTNET_VALUE
ENS_ROBOT_SAKHU_RESOLVER=REPLACE_WITH_TESTNET_VALUE
ENS_ROBOT_JANU_RESOLVER=REPLACE_WITH_TESTNET_VALUE
# Operator key: holds ROLE_SET_TEXT on all resolvers; sole ROLE_LINK/ROLE_UPGRADE holder
OPERATOR_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
# Safety officer: setText(status) only
SAFETY_OFFICER_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
# Robot keys: setText(last-episode) on own resolver only
ROBOT_RAMU_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
ROBOT_SAKHU_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
ROBOT_JANU_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE

# --- 0G Sponsor Integration (Compute & Storage) ---
# Operating mode: live (default) or mock. Mock is strictly forbidden in production.
ZERO_G_MODE=live

# --- 0G Compute (Router) ---
# ref: R-0G-1, REFERENCES.md §2
# Router is OpenAI-compatible at router-api.0g.ai/v1; verify_tee=true; id from ZG-Res-Key header
ZERO_G_ROUTER_BASE_URL=https://router-api.0g.ai/v1
# Secret: must be an inference sk- key, not a management mk- key
ZERO_G_ROUTER_API_KEY=REPLACE_WITH_TESTNET_VALUE
# Model ID from https://pc.0g.ai/models (e.g. glm-5.2)
ZERO_G_MODEL_ID=REPLACE_WITH_TESTNET_VALUE

# Optional compute tuning:
# ZERO_G_REQUEST_TIMEOUT_MS=20000
# ZERO_G_RETRY_DELAY_MS=250
# ZERO_G_MAX_RETRY_AFTER_MS=2000
# ZERO_G_MAX_OUTPUT_TOKENS=2048
# ZERO_G_MAX_PROMPT_CHARS=8000
# ZERO_G_MAX_RESPONSE_BYTES=65536
# ZERO_G_MAX_CONCURRENT=4
# ZERO_G_JSON_MODE=false
# ZERO_G_DISABLE_THINKING=false

# --- 0G Storage & Chain (Galileo testnet) ---
# ref: R-0G-2, REFERENCES.md §2
ZERO_G_STORAGE_NODE_URL=REPLACE_WITH_TESTNET_VALUE
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_CHAIN_ID=16602
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
# Throwaway funded Galileo testnet 0x-hex private key for storage uploads
ZERO_G_STORAGE_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
# Optional storage tuning:
# ZERO_G_STORAGE_TIMEOUT_MS=120000
# ZERO_G_MAX_EVIDENCE_BYTES=1048576
# RelayLedger contract — fill after B-4 (local Hardhat runs may emit this to .env only)
RELAY_LEDGER_ADDRESS=REPLACE_WITH_TESTNET_VALUE
# Gatekeeper signing key for chain writes
GATEKEEPER_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE

# --- Hedera (Testnet) ---
# ref: R-HE-1, R-HE-2, R-HE-3, R-HE-4, REFERENCES.md §3
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=REPLACE_WITH_TESTNET_VALUE
HEDERA_OPERATOR_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
# Spend Controller holds the only Hedera payment key — invariant §7.1
SPEND_CONTROLLER_HEDERA_ACCOUNT_ID=REPLACE_WITH_TESTNET_VALUE
SPEND_CONTROLLER_HEDERA_PRIVATE_KEY=REPLACE_WITH_TESTNET_VALUE
# HCS audit topic — fill after B-6
HEDERA_HCS_SPEND_TOPIC_ID=REPLACE_WITH_TESTNET_VALUE

# --- x402 Facilitators ---
# ref: R-HE-2; both open access, no API key required
X402_OFFICIAL_FACILITATOR_URL=https://x402.org/facilitator
X402_BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Route-intel server config
ROUTE_INTEL_SERVER_PORT=3001
ROUTE_INTEL_PRICE_PER_LEG_ATOMIC=REPLACE_WITH_TESTNET_VALUE
# Merchant account receiving payments
ROUTE_INTEL_MERCHANT_ACCOUNT_ID=REPLACE_WITH_TESTNET_VALUE

# --- Spend Controller limits ---
# Hard ceiling: immutable deploy-time limit; ENS budget cannot exceed this; invariant §7.9
SPEND_CONTROLLER_HARD_CEILING_ATOMIC=REPLACE_WITH_TESTNET_VALUE
# Per-request cap
SPEND_CONTROLLER_PER_REQUEST_CAP_ATOMIC=REPLACE_WITH_TESTNET_VALUE
# Policy cache TTL in ms (10–15 seconds; see ROADMAP §4.9)
SPEND_CONTROLLER_POLICY_CACHE_TTL_MS=12000

# --- Proof Worker ---
PROOF_WORKER_CIRCUIT_DIR=./circuits/mission-compliance/artifacts
PROOF_WORKER_WASM_PATH=./circuits/mission-compliance/artifacts/circuit.wasm
PROOF_WORKER_ZKEY_PATH=./circuits/mission-compliance/artifacts/circuit_final.zkey
SNARKJS_VERIFICATION_KEY_PATH=./circuits/mission-compliance/artifacts/verification_key.json

# --- Simulation ---
# Deterministic seed — must be fixed for reproducibility; invariant §7 (ROADMAP §4.3)
SIMULATION_SEED=DABBAWALA_2026_SEED_42
