# =============================================================================
# Dabbawala Protocol — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# --- Database (NeonDB) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Local EVM (Hardhat) ---
LOCAL_RPC_URL=http://127.0.0.1:8545
LOCAL_CHAIN_ID=31337

# --- Sepolia (ENSv2) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# --- ENSv2 (fill after S-ENS spike) ---
ENS_PARENT_NAME=dabbawala.eth
ENS_VERIFIABLE_FACTORY_ADDRESS=0x...
ENS_ROBOT_RAMU_RESOLVER=0x...
ENS_ROBOT_SAKHU_RESOLVER=0x...
ENS_ROBOT_JANU_RESOLVER=0x...

# --- Operator / Safety Officer Keys (testnet only) ---
OPERATOR_PRIVATE_KEY=0x...
SAFETY_OFFICER_PRIVATE_KEY=0x...

# --- Robot Keys (testnet placeholders only) ---
ROBOT_RAMU_PRIVATE_KEY=0x...
ROBOT_SAKHU_PRIVATE_KEY=0x...
ROBOT_JANU_PRIVATE_KEY=0x...

# --- Gatekeeper Key ---
GATEKEEPER_PRIVATE_KEY=0x...

# --- 0G Compute (Router) ---
ZERO_G_ROUTER_BASE_URL=https://router-api.0g.ai
ZERO_G_ROUTER_API_KEY=sk-...
ZERO_G_MODEL_ID=0g-openai-bot:latest

# --- 0G Storage ---
ZERO_G_STORAGE_NODE_URL=https://storage.0g.ai
ZERO_G_INDEXER_URL=https://indexer.0g.ai
ZERO_G_CHAIN_ID=16602
ZERO_G_RPC_URL=https://evm-rpc.0g.ai

# --- 0G Relay Ledger ---
RELAY_LEDGER_ADDRESS=0x...

# --- Hedera (Testnet) ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=0.0.xxxx
HEDERA_OPERATOR_PRIVATE_KEY=0x...
SPEND_CONTROLLER_HEDERA_ACCOUNT_ID=0.0.xxxx
SPEND_CONTROLLER_HEDERA_PRIVATE_KEY=0x...
HEDERA_HCS_SPEND_TOPIC_ID=0.0.xxxx

# --- x402 Facilitators ---
X402_OFFICIAL_FACILITATOR_URL=https://x402.org/facilitator
X402_BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- Route Intel Server ---
ROUTE_INTEL_SERVER_PORT=3001
ROUTE_INTEL_PRICE_PER_LEG_ATOMIC=10000000
ROUTE_INTEL_MERCHANT_ACCOUNT_ID=0.0.xxxx

# --- Spend Controller Limits ---
SPEND_CONTROLLER_HARD_CEILING_ATOMIC=50000000
SPEND_CONTROLLER_PER_REQUEST_CAP_ATOMIC=10000000
SPEND_CONTROLLER_POLICY_CACHE_TTL_MS=12000

# --- Simulation ---
SIMULATION_SEED=DABBAWALA_2026_SEED_42

# --- Zero-G Adapter Mode (live|mock|BLOCKED) ---
ZERO_G_MODE=live

# --- Vercel Deployment (optional) ---
# Vercel injects these automatically; no need to configure manually
# VERCEL_URL will be set by Vercel automatically