{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@dabbawala/api..."
      }
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/internal/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "api"
      }
    }
  ]
}
