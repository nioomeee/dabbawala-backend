{
  "name": "dabbawala-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:all": "pnpm -r --if-present run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\" --ignore-path .gitignore",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "turbo run db:migrate --filter=@dabbawala/database",
    "db:seed": "turbo run db:seed --filter=@dabbawala/database",
    "anvil:start": "anvil --chain-id 31337 --port 8545 --block-time 2",
    "forge:test": "cd contracts && forge test",
    "forge:build": "cd contracts && forge build",
    "circuits:compile": "cd circuits && bash scripts/compile.sh",
    "circuits:test": "cd circuits && bash scripts/test.sh",
    "security:slither": "cd contracts && slither .",
    "security:aderyn": "cd contracts && aderyn .",
    "ci:all": "pnpm lint && pnpm typecheck && pnpm test:all && pnpm forge:test"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@typescript-eslint/eslint-plugin": "8.6.0",
    "@typescript-eslint/parser": "8.6.0",
    "eslint": "9.27.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "light-my-request": "6.6.0"
    }
  }
}